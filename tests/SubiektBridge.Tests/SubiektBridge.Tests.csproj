<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Wyciszenie NuGet Audit (NU1903/NU1902) w projekcie testow: SqlClient 7.1.1 (przechodnio z Api) wymaga Pkcs >= 9.0.18,
         a 9.0.18 ma CVE-2026-84008 i CVE-2026-70162. Aplikacja tego pinu nie potrzebuje: od net11.0 Pkcs dostarcza
         Microsoft.AspNetCore.App i NuGet sam przycina pakiet (pin w Api dawal NU1510). Testy nie maja frameworka ASP.NET,
         wiec bez pinu dostaja 9.0.18. Do zdjecia, gdy SqlClient sam zazada wersji bez CVE. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SubiektBridge.Api\SubiektBridge.Api.csproj" />
  </ItemGroup>

</Project>
