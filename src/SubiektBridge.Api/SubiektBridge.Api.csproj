<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SubiektBridge.Api</RootNamespace>
    <AssemblyName>SubiektBridge.Api</AssemblyName>
    <UserSecretsId>subiekt-bridge-dev</UserSecretsId>
    <!-- CA1416 = "Validate platform compatibility" - tłumimy bo COM celowo windows-only,
         a [SupportedOSPlatform] mamy tam gdzie trzeba. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testy widzą internal helpery FakeSferaSession (ResetSettlementsForTests / InjectSettlementLineForTests). -->
    <InternalsVisibleTo Include="SubiektBridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- DLR (dynamic) jest wbudowany w .NET - nie trzeba osobnej referencji Microsoft.CSharp. -->

  </ItemGroup>

</Project>
