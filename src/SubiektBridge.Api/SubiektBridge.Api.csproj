<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SubiektBridge.Api</RootNamespace>
    <AssemblyName>SubiektBridge.Api</AssemblyName>
    <UserSecretsId>subiekt-bridge-dev</UserSecretsId>
    <!-- CA1416 = "Validate platform compatibility" - tłumimy bo COM celowo windows-only,
         a [SupportedOSPlatform] mamy tam gdzie trzeba. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testy widzą internal helpery FakeSferaSession (ResetSettlementsForTests / InjectSettlementLineForTests). -->
    <InternalsVisibleTo Include="SubiektBridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Wyciszenie NuGet Audit (NU1903/NU1902): SqlClient 7.1.1 wymaga Pkcs >= 9.0.18, a 9.0.18 ma CVE-2026-84008
         (HIGH, DoS) i CVE-2026-70162 (Moderate, DoS). Ten pin NIE zmienia binarek: Pkcs dostarcza Microsoft.AspNetCore.App
         (fxdep = runtime na hoście, self-contained = runtime pack z SDK na CI), więc realną poprawką jest build
         na runtime >= 10.0.13. Do zdjęcia, gdy SqlClient sam zażąda wersji bez CVE. -->

    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- DLR (dynamic) jest wbudowany w .NET 10 - nie trzeba osobnej referencji Microsoft.CSharp. -->

  </ItemGroup>

</Project>
